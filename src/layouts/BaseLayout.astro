---
import '../styles/global.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import Icon from '../components/Icon.astro';
import { initialWhatsApp, products } from '../data/products';
interface Props { title?: string; description?: string; image?: string; productId?: string; noindex?: boolean; }
const { title = 'Activos en venta · Su próximo proyecto empieza aquí', description = 'Un fundo, transporte lechero, equipos eléctricos y un local comercial. Conozca las ofertas y consulte directamente por WhatsApp.', image = '/media/fundo-mapa-referencial.webp', productId, noindex = false } = Astro.props;
const origin = import.meta.env.PUBLIC_SITE_ORIGIN?.trim() || '';
const interestProduct = products.find(product => product.id === productId);
const contactLink = initialWhatsApp(interestProduct, undefined, origin);
const canonical = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const ogImage = origin ? new URL(image, origin).href : undefined;
---
<!doctype html>
<html lang="es" data-product-id={productId} data-public-origin={origin}>
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/>
    <meta name="theme-color" content="#173e33"/><meta name="robots" content={origin && !noindex ? 'index,follow' : 'noindex,nofollow'}/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    {canonical && <link rel="canonical" href={canonical}/>}
    <meta property="og:type" content="website"/><meta property="og:site_name" content="Activos en venta"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
    {canonical && <meta property="og:url" content={canonical}/>}{ogImage && <meta property="og:image" content={ogImage}/>}
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{ogImage && <meta name="twitter:image" content={ogImage}/>}
  </head>
  <body data-product-id={productId}>
    <a href="#contenido" class="skip-link">Ir al contenido</a>
    <header class="site-header" data-site-header>
      <div class="header-inner"><a href="/" class="wordmark" aria-label="Activos en venta, inicio"><span class="brand-symbol" aria-hidden="true">a<span>v</span></span><span class="brand-type">activos<small>EN VENTA</small></span></a>
        <nav class="desktop-nav" aria-label="Navegación principal"><a href="/#catalogo">Las ofertas</a><a href="/#como-consultar">Cómo consultar</a><a href="/#contacto">Contacto</a></nav>
        <div class="header-actions"><a data-whatsapp href={contactLink} class="button button-small button-outline header-contact" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={17}/> Hablemos</a><button data-menu-toggle type="button" class="icon-button menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" size={24}/></button></div>
      </div>
      <nav id="mobile-nav" data-mobile-nav hidden aria-label="Navegación móvil"><a href="/#catalogo">Las ofertas</a><a href="/#como-consultar">Cómo consultar</a><a href="/#contacto">Contacto</a></nav>
    </header>
    <main id="contenido"><slot/></main>
    <footer id="contacto" class="site-footer"><div class="footer-top"><div><p class="eyebrow">UNA CONVERSACIÓN, EL SIGUIENTE PASO</p><h2>¿Encontró lo que<br/>estaba buscando?</h2><p>Consulte los detalles y coordine una visita.<br/>El contacto es directo, por WhatsApp.</p></div><div class="footer-contact"><a data-whatsapp href={contactLink} target="_blank" rel="noopener noreferrer" class="button button-light"><Icon name="whatsapp"/> Hablemos por WhatsApp <Icon name="arrow" size={18}/></a><a data-whatsapp href={contactLink} target="_blank" rel="noopener noreferrer" class="footer-number">+58 412-7856703</a><span>Único canal de contacto</span></div></div><div class="footer-bottom"><a href="/" class="footer-brand">activos <span>en venta</span></a><p>Disponibilidad y condiciones a confirmar con el vendedor.</p><a href="/#catalogo" class="footer-return">Ver todas las ofertas <Icon name="arrow" size={16}/></a></div></footer>
    <a data-whatsapp href={contactLink} class="floating-wa" target="_blank" rel="noopener noreferrer" aria-label="Consultar por WhatsApp"><Icon name="whatsapp" size={24}/><span>Consultar</span></a>
    <div data-toast class="toast" role="status" aria-live="polite" hidden></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
