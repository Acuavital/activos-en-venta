---
import '../styles/global.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import Icon from '../components/Icon.astro';
import { initialWhatsApp, products } from '../data/products';
interface Props { title?: string; description?: string; image?: string; productId?: string; noindex?: boolean; }
const { title = 'Activos en venta · Su próximo proyecto empieza aquí', description = 'Un fundo, transporte lechero, equipos eléctricos y un local comercial. Conozca las ofertas y consulte directamente por WhatsApp.', image = '/media/fundo-mapa-referencial.webp', productId, noindex = false } = Astro.props;
const origin = import.meta.env.PUBLIC_SITE_ORIGIN?.trim() || '';
const interestProduct = products.find(product => product.id === productId);
const contactLink = initialWhatsApp(interestProduct, undefined, origin);
const canonical = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const ogImage = origin ? new URL(image, origin).href : undefined;
---
<!doctype html>
<html lang="es" data-product-id={productId} data-public-origin={origin}>
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/>
    <meta name="theme-color" content="#ffffff"/><meta name="robots" content={origin && !noindex ? 'index,follow' : 'noindex,nofollow'}/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    {canonical && <link rel="canonical" href={canonical}/>}
    <meta property="og:type" content="website"/><meta property="og:site_name" content="Activos en venta"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
    {canonical && <meta property="og:url" content={canonical}/>}{ogImage && <meta property="og:image" content={ogImage}/>}
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{ogImage && <meta name="twitter:image" content={ogImage}/>}
  </head>
  <body data-product-id={productId}>
    <a href="#contenido" class="skip-link">Ir al contenido</a>
    <header class="site-header" data-site-header>
      <div class="header-inner section-wrap">
        <a href="/" class="wordmark" aria-label="Activos en venta, inicio">activos<span>en venta</span></a>
        <a data-whatsapp href={contactLink} class="button button-primary button-small" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={17}/> <span>WhatsApp</span></a>
      </div>
    </header>
    <main id="contenido"><slot/></main>
    <footer id="contacto" class="site-footer">
      <div class="footer-inner section-wrap">
        <div>
          <p class="footer-title">¿Le interesa algún activo?</p>
          <p class="footer-text">Escríbanos y coordine una visita. Disponibilidad y condiciones a confirmar con el vendedor.</p>
        </div>
        <a data-whatsapp href={contactLink} target="_blank" rel="noopener noreferrer" class="button button-primary"><Icon name="whatsapp" size={18}/> +58 412-7856703</a>
      </div>
    </footer>
    <div data-toast class="toast" role="status" aria-live="polite" hidden></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
