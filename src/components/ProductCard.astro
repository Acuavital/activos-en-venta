---
import Icon from './Icon.astro';
import Carousel from './Carousel.astro';
import { initialWhatsApp, productPath, money, type Product } from '../data/products';
interface Props { product: Product; eager?: boolean; }
const { product: p, eager = false } = Astro.props;
const origin = import.meta.env.PUBLIC_SITE_ORIGIN?.trim() || '';
---
<article class="product-card" data-product-card data-category={p.category}>
  <Carousel images={p.images} label={`Imágenes de ${p.shortTitle}`} variant="card" category={p.category} href={productPath(p)} linkLabel={`Ver detalles de ${p.shortTitle}`} eager={eager} />
  <div class="card-body">
    <a href={productPath(p)} class="card-title"><h3>{p.shortTitle}</h3></a>
    <p class="card-location"><Icon name="location" size={15}/>{p.location}</p>
    <p class="card-price"><strong>{p.priceLabel}</strong>{p.priceSuffix && <span>{p.priceSuffix}</span>}</p>
    {p.secondaryOption && <p class="card-note">{p.secondaryOption.label}: {money(p.secondaryOption.price)}</p>}
    {p.id === 'fundo' && <p class="card-note">Incluye planta y transformador. Rebaño y camión aparte.</p>}
    <div class="card-actions">
      <a href={productPath(p)} class="button button-ghost">Ver detalles</a>
      <a data-whatsapp data-product-id={p.id} href={initialWhatsApp(p, undefined, origin)} target="_blank" rel="noopener noreferrer" class="button button-primary" aria-label={`Consultar ${p.shortTitle} por WhatsApp`}><Icon name="whatsapp" size={18}/> Consultar</a>
    </div>
  </div>
</article>
