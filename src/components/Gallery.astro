---
import type { Product } from '../data/products';
interface Props { product: Product; }
const { product: p } = Astro.props;
---
{p.video && <section class="video-section" aria-labelledby="video-title">
  <h2 id="video-title">Video</h2>
  <video src={p.video} controls playsinline muted preload="metadata" poster={p.images[0].src} aria-label={`Video de ${p.shortTitle} sin audio`}></video>
  <p class="muted">Video real, sin pista de audio.</p>
</section>}
