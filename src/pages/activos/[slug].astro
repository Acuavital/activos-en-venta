---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Carousel from '../../components/Carousel.astro';
import Gallery from '../../components/Gallery.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, initialWhatsApp, money, type Product } from '../../data/products';
export function getStaticPaths() { return products.map(product => ({params:{slug:product.slug},props:{product}})); }
interface Props { product: Product; }
const { product: p } = Astro.props;
const others = products.filter(other=>other.id!==p.id).slice(0,3);
const origin = import.meta.env.PUBLIC_SITE_ORIGIN?.trim() || '';
const whatsapp = initialWhatsApp(p, undefined, origin);
---
<BaseLayout title={`${p.shortTitle} · ${p.priceLabel} | Activos en venta`} description={p.shareDescription} image={p.images[0].src} productId={p.id}>
  <div class="detail-top section-wrap"><a href="/#catalogo" class="back-link"><Icon name="prev" size={16}/> Todos los activos</a></div>
  <section class="detail-hero section-wrap">
    <div class="detail-media">
      <Carousel images={p.images} label={`Imágenes de ${p.shortTitle}`} variant="detail" eager />
      {p.imageNote && <p class="detail-note">{p.imageNote}</p>}
    </div>
    <div class="buy-box">
      <p class="buy-category">{p.category} · {p.eyebrow}</p>
      <h1>{p.title}</h1>
      <p class="buy-location"><Icon name="location" size={16}/>{p.location}</p>
      <div class="buy-price">
        <span class="buy-label" data-current-option>{p.secondaryOption?'Camión + tanque':'Precio de venta'}</span>
        <strong data-current-price>{p.priceLabel}</strong>{p.priceSuffix && <span class="buy-suffix">{p.priceSuffix}</span>}
      </div>
      {p.secondaryOption && <div class="option-selector" role="group" aria-label="Seleccione qué le interesa">
        <button type="button" data-option-id="conjunto" data-product-id={p.id} aria-pressed="true">Camión + tanque <span>{p.priceLabel}</span></button>
        <button type="button" data-option-id={p.secondaryOption.id} data-product-id={p.id} aria-pressed="false">{p.secondaryOption.label} <span>{money(p.secondaryOption.price)}</span></button>
      </div>}
      <a data-whatsapp data-product-id={p.id} href={whatsapp} target="_blank" rel="noopener noreferrer" class="button button-primary button-block"><Icon name="whatsapp"/> Consultar por WhatsApp</a>
      <div class="buy-secondary"><button type="button" data-share data-product-id={p.id} class="text-button"><Icon name="share" size={16}/> Compartir</button><button type="button" data-copy-link data-product-id={p.id} class="text-button"><Icon name="copy" size={16}/> Copiar enlace</button></div>
      <dl class="buy-highlights">{p.highlights.map(h=><div><dt>{h.label}</dt><dd>{h.value}</dd></div>)}</dl>
    </div>
  </section>
  <div class="detail-body section-wrap">
    <div class="detail-content">
      <section class="detail-block">
        <h2>Descripción</h2>
        <p class="lead">{p.summary}</p>
        {p.description.map(text=><p>{text}</p>)}
      </section>
      {p.sections.map(section=><section class="detail-block"><h3>{section.title}</h3><p>{section.body}</p>{section.bullets && <ul>{section.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}
      <section class="detail-block" id="caracteristicas"><h2>Características</h2><dl class="spec-list">{p.specs.map(spec=><div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl></section>
      <Gallery product={p}/>
    </div>
    <aside class="conditions">
      <h2>Condiciones</h2>
      <ul>{p.conditions.map(c=><li><Icon name="check" size={16}/><span>{c}</span></li>)}</ul>
      <a data-whatsapp data-product-id={p.id} href={whatsapp} target="_blank" rel="noopener noreferrer" class="button button-ghost button-block">Coordinar una visita</a>
    </aside>
  </div>
  <section class="others section-wrap" aria-labelledby="others-title">
    <div class="others-head"><h2 id="others-title">Otros activos en venta</h2><a href="/#catalogo" class="text-button">Ver todos <Icon name="arrow" size={16}/></a></div>
    <div class="catalog-grid">{others.map(other=><ProductCard product={other}/>)}</div>
  </section>
</BaseLayout>
