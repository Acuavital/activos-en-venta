---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
const categories = [
  {label:'Todos',value:'todos'},
  {label:'Campo',value:'Campo'},
  {label:'Transporte',value:'Transporte'},
  {label:'Energía',value:'Energía'},
  {label:'Inmuebles',value:'Inmuebles'},
];
---
<BaseLayout>
  <section class="home-intro section-wrap">
    <h1>Activos en venta</h1>
    <p>Fotos reales, precio claro y trato directo con el vendedor por WhatsApp.</p>
  </section>
  <section id="catalogo" class="catalog section-wrap" aria-label="Catálogo de activos">
    <div class="catalog-bar">
      <div class="filter-tabs" role="group" aria-label="Filtrar por categoría">{categories.map((c,index)=><button type="button" data-filter={c.value} aria-pressed={index===0}>{c.label}</button>)}</div>
      <span class="catalog-count" data-catalog-count>{products.length} activos disponibles</span>
    </div>
    <div class="catalog-grid">{products.map((product,index)=><ProductCard product={product} eager={index < 3}/>)}</div>
  </section>
</BaseLayout>
